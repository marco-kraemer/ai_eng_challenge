OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional writable cache directory. Default: .cache/ in the project root.
# POLICY_CACHE_DIR=/path/to/cache

# Required on Vercel; optional locally to test shared state. Configure as Vercel secrets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional isolation override. Default: production, or environment + branch hash.
# STATE_NAMESPACE=emporio-production
# On Vercel POLICY_CACHE_DIR defaults to /tmp/emporio-policy-cache.
