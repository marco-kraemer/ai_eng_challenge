LLM_PROVIDER=openai
OPEN_AI_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY is also accepted; OPEN_AI_KEY takes precedence.
# Optional legacy provider: set LLM_PROVIDER=openrouter explicitly.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# Optional writable cache directory. Default: .cache/ in the project root.
# POLICY_CACHE_DIR=/path/to/cache

# Required on Vercel; optional locally to test shared state. Configure as Vercel secrets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional isolation override. Default: production, or environment + branch hash.
# STATE_NAMESPACE=emporio-production
# On Vercel POLICY_CACHE_DIR defaults to /tmp/emporio-policy-cache.

# Optional sanitized tracing. No prompts, customer text or order credentials are exported.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-musica
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set false for tests or to disable exports without deleting the key.
EMPORIO_TRACING=true
